{
  "name": "@avd/runtime",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "description": "Runtime library for displays built with WYSIWYG Avionics Builder (MSFS Avionics Framework).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./ace-polyfill": "./dist/ace-polyfill.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@microsoft/msfs-sdk": "^2.3.3"
  },
  "devDependencies": {
    "@microsoft/msfs-types": "^1.14.6"
  }
}
